/target
node_modules/

# Agent guidance stays untracked, as on the compiler and interpreter tracks.
CLAUDE.md
AGENTS.md
.docs

# insta writes these while a snapshot is under review; the reviewed .snap is
# what gets committed (CONTRIBUTING.md, "the snapshot ritual").
*.snap.new
*.pending-snap

# The CI artifact cache for the `wolf` binary at PIN. Downloaded, never built
# here and never committed (ls00 §3).
/.wolf-bin/

# Latency-budget JSONL (D5 shape). Emitted, uploaded as an artifact, not tracked.
/bench-results/

# The VS Code extension's build output and test downloads (ls05). `out/` is
# compiled from `src/`, `.vscode-test/` is a full VS Code build the harness
# downloads, and the vsix is a release artifact built on demand -- none of the
# three is a source of truth and all three are large.
clients/vscode/out/
clients/vscode/.vscode-test/
clients/vscode/*.vsix

# The Zed extension's build output. `/target` above is anchored at the repo
# root and does not cover a crate that is deliberately outside the workspace
# (ls06). The artifact is a wasm32-wasip2 component built on demand.
clients/zed/target/
