{
  "information_for_contributors": [
    "GENERATED by `cargo xtask grammar-generate` from vendor/upstream/spec/grammar.ebnf.",
    "DO NOT EDIT. `cargo xtask grammar-drift` regenerates this file and compares bytes,",
    "so a hand edit here fails CI as drift — which is the point (ls05 §2).",
    "This file: the TextMate grammar for `.lu` source.",
    "The remedy for a real upstream change is always one commit: bump the pin,",
    "re-vendor, `cargo xtask grammar-generate`, commit together."
  ],
  "name": "Wolf",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "attributes": {
      "begin": "#\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.wolf"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.wolf"
        }
      },
      "name": "meta.attribute.wolf",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        }
      ]
    },
    "block-string": {
      "begin": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.wolf"
        }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.wolf"
        }
      },
      "name": "string.quoted.triple.wolf",
      "patterns": [
        {
          "include": "#interpolation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "//[/!].*$",
          "name": "comment.line.documentation.wolf"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.wolf"
        }
      ]
    },
    "format-spec": {
      "match": ":[^{}\"]*(?=\\})",
      "name": "constant.other.format-spec.wolf"
    },
    "generalized-string": {
      "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)(\")",
      "beginCaptures": {
        "1": {
          "name": "support.function.generalized.wolf"
        },
        "2": {
          "name": "punctuation.definition.string.begin.wolf"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.wolf"
        }
      },
      "name": "string.quoted.other.generalized.wolf",
      "patterns": [
        {
          "include": "#interpolation"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.wolf"
        },
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.wolf"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.wolf"
            }
          },
          "name": "meta.embedded.expression.wolf",
          "patterns": [
            {
              "include": "#format-spec"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#operators"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(false|true)\\b",
          "name": "constant.language.wolf"
        },
        {
          "match": "\\b(else|if|match)\\b",
          "name": "keyword.control.conditional.wolf"
        },
        {
          "match": "\\b(for|in|loop|while)\\b",
          "name": "keyword.control.repeat.wolf"
        },
        {
          "match": "\\b(break|continue|defer|errdefer|return)\\b",
          "name": "keyword.control.flow.wolf"
        },
        {
          "match": "\\b(import|use)\\b",
          "name": "keyword.control.import.wolf"
        },
        {
          "match": "\\b(borrow|freeze|move|proc|region|scope|select|spawn|when)\\b",
          "name": "keyword.control.concurrency.wolf"
        },
        {
          "match": "\\b(const|enum|fn|impl|let|struct|trait|type|var)\\b",
          "name": "storage.type.wolf"
        },
        {
          "match": "\\b(asm|assume|comptime|copy|distinct|dyn|export|extern|handle|mut|pub|shared|take|unsafe|weak)\\b",
          "name": "storage.modifier.wolf"
        },
        {
          "match": "\\b(as)\\b",
          "name": "keyword.other.wolf"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b",
          "name": "constant.numeric.hex.wolf"
        },
        {
          "match": "\\b0o[0-7][0-7_]*\\b",
          "name": "constant.numeric.octal.wolf"
        },
        {
          "match": "\\b0b[01][01_]*\\b",
          "name": "constant.numeric.binary.wolf"
        },
        {
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)",
          "name": "constant.numeric.float.wolf"
        },
        {
          "match": "\\b[0-9][0-9_]*\\b",
          "name": "constant.numeric.decimal.wolf"
        }
      ]
    },
    "operators": {
      "match": "&mut|\\.\\.=|<<=|<=>|>>=|!=|%=|&&|&=|\\*=|\\+=|-=|->|\\.\\.|\\/=|<<|<=|==|=>|>=|>>|\\^=|\\|=|\\|\\||!|%|&|\\*|\\+|-|\\/|<|=|>|\\?|@|\\^|\\|",
      "name": "keyword.operator.wolf"
    },
    "quoted-string": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.wolf"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.wolf"
        }
      },
      "name": "string.quoted.double.wolf",
      "patterns": [
        {
          "include": "#interpolation"
        }
      ]
    },
    "raw-string": {
      "begin": "\\br(#*)\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.wolf"
        }
      },
      "end": "\"\\1",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.wolf"
        }
      },
      "name": "string.quoted.other.raw.wolf",
      "patterns": [
        {
          "include": "#interpolation"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#block-string"
        },
        {
          "include": "#raw-string"
        },
        {
          "include": "#generalized-string"
        },
        {
          "include": "#quoted-string"
        }
      ]
    },
    "types": {
      "match": "\\b(Self|bool|byte|f32|f64|i16|i32|i64|i8|int|str|u16|u32|u64|u8|uint|wrapping)\\b",
      "name": "support.type.wolf"
    }
  },
  "scopeName": "source.wolf"
}
