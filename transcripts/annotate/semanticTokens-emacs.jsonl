{"dir":"c2s","kind":"notification","method":"textDocument/didOpen","params":{"textDocument":{"languageId":"wolf","text":"//! check: run(exit=0, stdout=\"hello, wolf\")\n//! phase: run\n//! conforms: str.interp\n//!\n//! The first program. Every string literal is an f-string (D26/X9);\n//! `main` returns `!int` (D30) with the last expression as the value.\n//! `print` appends a newline; stdout matching ignores the trailing one.\n\nfn main() -> !int {\n    let who = \"wolf\"\n    print(\"hello, {who}\")\n    0\n}\n","uri":"file://$WS/hello.lu","version":1}},"seq":11}
