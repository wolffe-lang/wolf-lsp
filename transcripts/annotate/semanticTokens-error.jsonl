{"dir":"c2s","kind":"notification","method":"textDocument/didOpen","params":{"textDocument":{"languageId":"wolf","text":"//! check: run(exit=0, stdout=\"1/n9/n\")\n//! phase: run\n//! conforms: gram.item.error, type.err.alias, gram.type.row.flatten\n//!\n//! s158 (#36) — aliases compose by NAMING ([type.err.alias.union]):\n//! an entry whose path resolves to an alias contributes that alias's\n//! tags, everything else is a tag, and the union is\n//! [gram.type.row.flatten]'s — an alias is one more layer, and layers\n//! flatten. `{IoErrors, closed}` here is `{none, parse, closed}`, and\n//! a tag repeated across the layers is one tag.\n\nerror IoErrors = {none, parse}\n\nerror ConfigErrors = {IoErrors, closed}\n\nfn load(ok: bool) -> int ! ConfigErrors {\n    if ok { 1 } else { return closed }\n}\n\nfn main() -> !int {\n    print(\"{load(true) else 9}\")\n    print(\"{load(false) else 9}\")\n    0\n}\n","uri":"file://$WS/rows/error_alias_union.lu","version":1}},"seq":4}
