{"dir":"c2s","kind":"notification","method":"textDocument/didOpen","params":{"textDocument":{"languageId":"wolf","text":"//! check: run(exit=0, stdout=\"3/n4/n\")\n//! phase: run\n//! conforms: gram.item.error, gram.inv.ctx\n//!\n//! s158 (#36) — `error` is CONTEXTUAL, not reserved\n//! ([gram.inv.ctx]): the keyword only in item position with an\n//! `IDENT` and an `=` after it. Two tokens of lookahead decide, so a\n//! binding named `error`, a field named `error` and a function named\n//! `error` all still parse, and [gram.inv.kw]'s fifty are unchanged.\n\ntype Report = struct {\n    error: int,\n}\n\nfn error(n: int) -> int {\n    n + 1\n}\n\nfn main() -> !int {\n    let error = 3\n    print(\"{error}\")\n    let r = Report { error: error + 1 }\n    print(\"{r.error}\")\n    0\n}\n","uri":"file://$WS/rows/error_alias_ident.lu","version":1}},"seq":12}
