{"dir":"c2s","kind":"notification","method":"textDocument/didOpen","params":{"textDocument":{"languageId":"wolf","text":"//! check: run(exit=0, stdout=\"true\")\n//! phase: run\n//! conforms: os.env.argv, os.host.sigs\n//!\n//! A native conformance runner starts a program with an invocation name;\n//! the checked machine has none by default. Both readers agree on the\n//! name's bytes in their own execution context, without inventing a path.\n\nfn main() -> !int {\n    let name = env_arg0()\n    let argv = env_args_bytes()\n    var same = name.len == 0\n    if argv.len > 0 {\n        let decoded = str_from_utf8(argv[0])?\n        same = name == decoded\n    }\n    print(\"{same}\")\n    0\n}\n","uri":"file://$WS/os/arg0.lu","version":1}},"seq":4}
