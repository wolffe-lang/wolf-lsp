#! wolf-lsp#42: the one session that reaches the standard library. Since
#! 0.2.29 (s235) `wolf lsp` loads the `std/` beside its own binary, so the
#! installed server resolves `xs.any(…)` on a `List` to `std.list`'s `any`:
#! no diagnostic, a hover naming the home module, a definition INTO the std
#! (its absolute path elided `$STD`, as `$WS` is), and the module's
#! functions completed after `xs.` once a line ending in it is typed (an
#! unedited `xs.any` completes nothing). The harness clears the caller's
#! `WOLF_STD`, so this is the std installed with the binary and nothing else.
#! Read with `std/no-std`: the same file and requests with no std beside the
#! server.
name      std/reach
profile   minimal

initialize
open      typecheck/method_home_no_std.lu
wait      diagnostics typecheck/method_home_no_std.lu
req       hover typecheck/method_home_no_std.lu 10:15
req       definition typecheck/method_home_no_std.lu 10:15
edit      typecheck/method_home_no_std.lu "//! check: fail(E0301)\n//! phase: resolve\n//! conforms: type.method.root\n//!\n//! s166 — `any` is not a builtin method of `List`, so it comes from\n//! `std.list`, and no std root is configured for this directory: E0301\n//! naming the ways to configure one, never a builtin stand-in.\n\nfn main() -> !int {\n    let xs = [1, 2, 3]\n    let p = xs.\n    let b = xs.any(fn(x: int) { x > 1 })\n    0\n}\n"
wait      diagnostics typecheck/method_home_no_std.lu
req       completion typecheck/method_home_no_std.lu 10:15 .
shutdown
